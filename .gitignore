# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# database
/prisma/*.db
/prisma/*.db-journal

# uploaded covers (keep folder)
/public/covers/*
!/public/covers/.gitkeep

# personal / source photos (do not upload)
/public/mascot/aoao-photo.jpg
/public/mascot/*-photo.*

# tesseract language packs (downloaded locally)
*.traineddata

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
